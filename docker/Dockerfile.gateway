FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Gateway/NovaKnowledge.Gateway/NovaKnowledge.Gateway.csproj
RUN dotnet publish src/Gateway/NovaKnowledge.Gateway/NovaKnowledge.Gateway.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "NovaKnowledge.Gateway.dll"]
