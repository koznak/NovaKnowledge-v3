{
  "ConnectionStrings": {
    "NovaKnowledgeDb": "Host=localhost;Port=5432;Database=novaknowledge;Username=postgres;Password=postgres"
  },
  "AzureOpenAI": {
    "Endpoint": "https://YOUR-CHAT-RESOURCE.openai.azure.com/",
    "ApiKey": "",
    "EmbeddingEndpoint": "https://YOUR-EMBEDDING-RESOURCE.openai.azure.com/",
    "EmbeddingApiKey": "",
    "ChatDeployment": "gpt-5-mini-2",
    "EmbeddingDeployment": "text-embedding-3-large",
    "EmbeddingDimensions": 3072
  },
  "AzureSearch": {
    "Endpoint": "https://YOUR-SEARCH-RESOURCE.search.windows.net",
    "ApiKey": "",
    "IndexName": "novaknowledge-documents",
    "EnableHybridSearch": false,
    "VectorDimensions": 3072
  },
  "AzureStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "DocumentsContainer": "documents",
    "ExportsContainer": "exports"
  },
  "ServiceBus": {
    "ConnectionString": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true",
    "DocumentUploadedQueue": "document-uploaded"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "ServiceUrls": {
    "SearchApi": "http://localhost:5003",
    "OrchestrationApi": "http://localhost:5002",
    "EvaluationService": "http://localhost:8000"
  },
  "NovaKnowledge": {
    "DefaultTenantId": "contoso"
  },
  "Pricing": {
    "PromptCostPer1KTokens": 0.00015,
    "CompletionCostPer1KTokens": 0.0006
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
