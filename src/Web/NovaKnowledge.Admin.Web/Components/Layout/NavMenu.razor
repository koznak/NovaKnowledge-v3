<div class="top-row ps-3 navbar navbar-dark bg-primary">
    <div class="container-fluid">
        <NavLink class="navbar-brand fw-bold" href="" Match="NavLinkMatch.All">NovaKnowledge</NavLink>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" @bind="_mobileNavOpen" />

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMobileNav">
                <i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documents" @onclick="CloseMobileNav">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Documents
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="prompts" @onclick="CloseMobileNav">
                <i class="bi bi-chat-quote" aria-hidden="true"></i> Prompts & Eval
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings" @onclick="CloseMobileNav">
                <i class="bi bi-gear" aria-hidden="true"></i> Settings
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool _mobileNavOpen;

    private void CloseMobileNav() => _mobileNavOpen = false;
}
