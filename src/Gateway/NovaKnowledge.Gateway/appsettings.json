{
  "ReverseProxy": {
    "Routes": {
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      },
      "ingest-route": {
        "ClusterId": "ingest-cluster",
        "Match": { "Path": "/api/ingest/{**catch-all}" }
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/api/search/{**catch-all}" }
      },
      "feedback-route": {
        "ClusterId": "feedback-cluster",
        "Match": { "Path": "/api/feedback/{**catch-all}" }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "orchestration-route": {
        "ClusterId": "orchestration-cluster",
        "Match": { "Path": "/api/orchestration/{**catch-all}" }
      }
    },
    "Clusters": {
      "chat-cluster": {
        "Destinations": {
          "chat": { "Address": "http://localhost:5001/" }
        }
      },
      "ingest-cluster": {
        "Destinations": {
          "ingest": { "Address": "http://localhost:5004/" }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search": { "Address": "http://localhost:5003/" }
        }
      },
      "feedback-cluster": {
        "Destinations": {
          "feedback": { "Address": "http://localhost:5005/" }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin": { "Address": "http://localhost:5006/" }
        }
      },
      "orchestration-cluster": {
        "Destinations": {
          "orchestration": { "Address": "http://localhost:5002/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
